### =========================================
### SAFEKITCHEN API
### =========================================

@baseUrl = http://localhost:3000

### =========================================
### STATUS SISTEMA
### =========================================

### Buscar status atual
GET {{baseUrl}}/status

###

### Atualizar status NORMAL
PUT {{baseUrl}}/status
Content-Type: application/json

{
  "calor": 0,
  "fumaca": 0,
  "glp": 0,
  "movimento": 1,
  "ventilacao": 1,
  "gas": 1,
  "bomba": 0,
  "tomadas": 1,
  "estado_geral": "NORMAL"
}

###

### Simular INCÊNDIO
PUT {{baseUrl}}/status
Content-Type: application/json

{
  "calor": 1,
  "fumaca": 1,
  "glp": 0,
  "movimento": 1,
  "ventilacao": 1,
  "gas": 0,
  "bomba": 1,
  "tomadas": 0,
  "estado_geral": "INCENDIO"
}

###

### Simular VAZAMENTO GLP
PUT {{baseUrl}}/status
Content-Type: application/json

{
  "calor": 0,
  "fumaca": 0,
  "glp": 1,
  "movimento": 0,
  "ventilacao": 1,
  "gas": 0,
  "bomba": 0,
  "tomadas": 0,
  "estado_geral": "EMERGENCIA"
}

###

### Resetar sistema
POST {{baseUrl}}/status/reset

### =========================================
### EVENTOS
### =========================================

### Listar todos os eventos
GET {{baseUrl}}/eventos

###

### Buscar evento por ID
GET {{baseUrl}}/eventos/1

###

### Buscar eventos ALERTA
GET {{baseUrl}}/eventos/tipo/ALERTA

###

### Buscar eventos INCENDIO
GET {{baseUrl}}/eventos/tipo/INCENDIO

###

### Criar evento ALERTA
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "tipo": "ALERTA",
  "mensagem": "Temperatura elevada detectada",
  "sensor": "calor",
  "atuador": "ventilacao"
}

###

### Criar evento INCÊNDIO
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "tipo": "INCENDIO",
  "mensagem": "Incêndio detectado na cozinha",
  "sensor": "fumaca,calor",
  "atuador": "bomba,gas,tomadas"
}

###

### Criar evento EMERGÊNCIA
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "tipo": "EMERGENCIA",
  "mensagem": "Vazamento de GLP detectado",
  "sensor": "glp",
  "atuador": "gas,ventilacao"
}

###

### Deletar evento
DELETE {{baseUrl}}/eventos/1

###

### Limpar todos os eventos
DELETE {{baseUrl}}/eventos

### =========================================
### HISTÓRICO DE SENSORES
### =========================================

### Listar histórico
GET {{baseUrl}}/historico

###

### Buscar histórico por ID
GET {{baseUrl}}/historico/1

###

### Criar leitura NORMAL
POST {{baseUrl}}/historico
Content-Type: application/json

{
  "calor": 0,
  "fumaca": 0,
  "glp": 0,
  "movimento": 1
}

###

### Criar leitura INCÊNDIO
POST {{baseUrl}}/historico
Content-Type: application/json

{
  "calor": 1,
  "fumaca": 1,
  "glp": 0,
  "movimento": 1
}

###

### Criar leitura GLP
POST {{baseUrl}}/historico
Content-Type: application/json

{
  "calor": 0,
  "fumaca": 0,
  "glp": 1,
  "movimento": 0
}

###

### Limpar histórico
DELETE {{baseUrl}}/historico

### =========================================
### NOTIFICAÇÕES
### =========================================

### Listar notificações
GET {{baseUrl}}/notificacoes

###

### Buscar notificação por ID
GET {{baseUrl}}/notificacoes/1

###

### Criar notificação EMAIL
POST {{baseUrl}}/notificacoes
Content-Type: application/json

{
  "tipo": "EMAIL",
  "destino": "admin@safekitchen.com",
  "mensagem": "Incêndio detectado",
  "enviado": 0
}

###

### Criar notificação SMS
POST {{baseUrl}}/notificacoes
Content-Type: application/json

{
  "tipo": "SMS",
  "destino": "+551399999999",
  "mensagem": "Vazamento de GLP detectado",
  "enviado": 0
}

###

### Marcar notificação como enviada
PUT {{baseUrl}}/notificacoes/1/enviada

###

### Deletar notificação
DELETE {{baseUrl}}/notificacoes/1

###

### Limpar notificações
DELETE {{baseUrl}}/notificacoes